---
// The whole page is a camera monitor: status bar on top, scene, focus scale and white balance at the bottom.
import { url } from '../lib/paths';

const home = url();
const links = [
  { href: `${home}#work`, label: 'Work' },
  { href: `${home}#chapters`, label: 'Chapters' },
  { href: `${home}#about`, label: 'About' },
  { href: `${home}#contact`, label: 'Contact' },
];
const marks = ['0.3', '0.5', '1', '2', '5', '∞'];
---

<div class="hud-blur hud-blur-top" aria-hidden="true"></div>
<div class="hud-blur hud-blur-bottom" aria-hidden="true"></div>

<div class="hud-frame" aria-hidden="true">
  <span class="hud-c hud-c-tl"></span>
  <span class="hud-c hud-c-tr"></span>
  <span class="hud-c hud-c-bl"></span>
  <span class="hud-c hud-c-br"></span>
  <span class="hud-center"></span>
</div>

<header class="hud-top">
  <a class="hud-brand" href={home}>
    <span class="hud-rec" aria-hidden="true"><i></i>REC</span>
    <span class="brand-full">Nefeli Koumantaki</span>
    <span class="brand-short" aria-hidden="true">NK</span>
  </a>
  <nav class="hud-nav" aria-label="Main">
    <ul>
      {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
    </ul>
  </nav>
  <div class="hud-status" aria-hidden="true">
    <span>4K · 24p</span>
    <span class="hud-tc">TC <b data-timecode>00:00:00:00</b></span>
    <span class="battery"><i></i></span>
  </div>
</header>

<div class="hud-bottom">
  <p class="hud-scene" aria-hidden="true" hidden>
    <span class="hud-scene-n" data-scene-n>SC.01</span>
    <span data-scene-label>Opening titles</span>
  </p>
  <div class="hud-focus" aria-hidden="true">
    <span class="hud-focus-label">Focus</span>
    <span class="hud-focus-scale">
      {marks.map((m) => <span>{m}</span>)}
      <i class="hud-needle"></i>
    </span>
  </div>
  <button class="wb" type="button" data-lights aria-pressed="false" aria-label="House lights" hidden>
    <span class="wb-label">WB</span>
    <span class="wb-opt wb-night">
      <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><path d="M10.5 2.2a6 6 0 1 0 3.3 9.2 5 5 0 0 1-3.3-9.2Z" fill="currentColor"></path></svg>
      3200K
    </span>
    <span class="wb-opt wb-day">
      <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><circle cx="8" cy="8" r="3" fill="currentColor"></circle><path d="M8 1v2M8 13v2M1 8h2M13 8h2M3 3l1.4 1.4M11.6 11.6 13 13M3 13l1.4-1.4M11.6 4.4 13 3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"></path></svg>
      5600K
    </span>
  </button>
</div>
