---
import { SITE } from '../data/site';
import { url } from '../lib/paths';

// A real download link styled as a clapperboard. JavaScript adds the slam, the flash and the take counter.
// Slate-style date, dd.mm.yy. The script swaps in today's date in the browser.
const slateDate = (d: Date) =>
  [d.getDate(), d.getMonth() + 1, d.getFullYear() % 100].map((n) => String(n).padStart(2, '0')).join('.');
const today = slateDate(new Date());
---

<div class="clapper-wrap">
  <a
    class="clapper"
    href={url(SITE.cv)}
    download={SITE.cvDownloadName}
    data-clapper
    data-cursor="Action!"
  >
    <span class="clapper-arm" aria-hidden="true"></span>
    <span class="clapper-board">
      <span class="clapper-title">Download CV</span>
      <span class="clapper-grid" aria-hidden="true">
        <span>Prod. <em>Nefeli K.</em></span>
        <span>Roll <em>A001</em></span>
        <span>Scene <em>CV</em></span>
        <span>Take <em data-take>1</em></span>
        <span>Date <em data-clap-date>{today}</em></span>
        <span>Format <em>PDF</em></span>
      </span>
    </span>
  </a>
  <p class="clapper-msg" aria-live="polite" data-clapper-msg></p>
</div>
