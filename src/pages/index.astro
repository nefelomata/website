---
import { Picture, getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import FilmCard from '../components/FilmCard.astro';
import Clapper from '../components/Clapper.astro';
import CallSheet from '../components/CallSheet.astro';
import Arrow from '../components/Arrow.astro';
import portrait from '../assets/portrait.jpg';
import Cloud from '../components/Cloud.astro';
import { SITE } from '../data/site';
import { url, chapterNumeral } from '../lib/paths';

const films = (await getCollection('films')).sort((a, b) => a.data.order - b.data.order);
const chapters = (await getCollection('chapters', (c) => import.meta.env.DEV || !c.data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);

// How wide each film card is, out of 12 columns: two per row, alternating big and small.
const SPANS = [7, 5, 5, 7, 6, 6];

const home = new URL(url(), Astro.site).href;
const portraitUrl = new URL((await getImage({ src: portrait, width: 900, format: 'jpg' })).src, Astro.site).href;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    '@id': `${home}#nefeli`,
    name: SITE.name,
    jobTitle: SITE.jobTitle,
    description: SITE.description,
    url: home,
    image: portraitUrl,
    email: `mailto:${SITE.email}`,
    sameAs: [SITE.linkedin],
    address: { '@type': 'PostalAddress', addressLocality: SITE.city, addressCountry: 'GR' },
    alumniOf: { '@type': 'CollegeOrUniversity', name: 'Athens University of Economics and Business' },
    knowsLanguage: ['el', 'en', 'nl'],
    knowsAbout: ['Film production', 'Production management', 'Script supervision', 'Copywriting', 'Advertising', 'Brand marketing'],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    url: home,
    author: { '@id': `${home}#nefeli` },
  },
];

const reasons = [
  {
    h: "I've worked to the brief, the budget and the deadline.",
    sub: 'Five years across brands and agencies.',
    items: [
      'Copywriter, McCann Greece, 2025 to now',
      'Copywriter & script supervisor, FlexCar, 2024–25',
      'Copywriter, DDB Greece, 2022–23',
      'Junior marketing coordinator, Intersport Greece, 2021–22',
    ],
  },
  {
    h: 'I coordinate people who don’t speak the same language.',
    sub: 'Different departments, different mindsets. I speak all of them.',
    items: [
      'Opened a shop for the Athens Marathon in five days, across every department',
      'Ran newsletters for Greece, Cyprus, Italy and Turkey, between the commercial team and the agency',
      'Seasonal 360 campaigns, from the brief to the results',
      'Social media for Intersport Greece & Cyprus and The Athlete’s Foot',
    ],
  },
  {
    h: 'I’ve already stood on a set.',
    sub: 'Production manager, production assistant, script supervisor and director.',
    items: [
      'Production manager · Kyklamino',
      'Production assistant · Epi Gis, Oops',
      'Script supervisor · Kai Zisan Aftoi Kalytera',
      'Director · Shadows, One Day',
      'Wrote and supervised the scripts on about four influencer shoots at FlexCar',
    ],
    more: { href: '#work', text: 'See the films' },
  },
  {
    h: 'I’m switching worlds on purpose.',
    sub: 'Marketing, brand and advertising: all of it is useful in production.',
    items: [
      'I know what a client will ask for, because I used to be in that room',
      'BSc Marketing & Communication, Athens University of Economics & Business',
      'Film school, 2024–25',
    ],
  },
];

const facts = [
  ['Based in', 'Athens, Greece'],
  ['Studied', 'BSc Marketing & Communication, Athens University of Economics & Business'],
  ['Erasmus+', 'Ghent University, Belgium, 2020'],
  ['Speaks', 'Greek (native), English (C2), Dutch (A2, be patient)'],
  ['Ballet', '2002–2015, two Royal Academy of Dance qualifications'],
  ['On shoot days', 'Calm. Suspiciously calm.'],
];
---

<Base jsonLd={jsonLd} type="profile">
  <!-- SC.01 · Opening titles -->
  <section class="hero" data-scene="SC.01|Opening titles" aria-labelledby="hero-name">
    <div class="letterbox" aria-hidden="true"><span></span><span></span></div>
    <div class="hero-grid wrap">
      <div class="hero-head">
        <p class="slate"><span class="slate-sc">SC.01</span> Opening titles</p>
        <h1 id="hero-name" class="hero-name">
          <span class="hero-line"><span>Nefeli</span></span>{' '}
          <span class="hero-line"><span>Koumantaki</span></span>
        </h1>
      </div>

      <figure class="viewfinder" data-viewfinder>
        <div class="vf-frame">
          <Picture
            src={portrait}
            alt="Nefeli Koumantaki in black and white, hood up, looking down at the camera with pine trees behind her."
            widths={[360, 540, 720, 900]}
            sizes="(min-width: 900px) 30vw, 88vw"
            formats={['avif', 'webp']}
            quality={68}
            loading="eager"
            fetchpriority="high"
          />
          <div class="vf-dof" aria-hidden="true"></div>
          <div class="vf-hud" aria-hidden="true">
            <span class="vf-thirds"></span>
            <span class="vf-c vf-c-tl"></span><span class="vf-c vf-c-tr"></span>
            <span class="vf-c vf-c-bl"></span><span class="vf-c vf-c-br"></span>
            <span class="vf-row vf-top"><span>Mon A</span><span class="vf-extra">Face detect</span></span>
            <span class="vf-row vf-bottom"><span>ISO 800</span><span>1/50</span><span>f/1.8</span><span class="vf-extra">50 mm</span></span>
            <span class="vf-af" data-af><b data-af-label>AF · face</b></span>
          </div>
        </div>
        <figcaption class="vf-caption">
          <span class="vf-hint">Move to pull focus.</span> Yes, I’m the one with the call sheet.
        </figcaption>
      </figure>

      <div class="hero-copy">
        <p class="hero-role">Film production <span aria-hidden="true">/</span> Copywriting <span aria-hidden="true">/</span> Athens</p>
        <p class="lede">
          I spent five years in advertising. Now I make sure films actually get made: <strong class="hl">on schedule, on budget,</strong> and with everyone fed.
        </p>
        <div class="hero-cta">
          <a class="btn btn-primary" href="#work">See the work <Arrow dir="down" /></a>
          <a class="btn btn-ghost" href={url(SITE.cv)} download={SITE.cvDownloadName}>Download CV</a>
        </div>
      </div>
    </div>

  </section>

  <!-- SC.02 · Cold open -->
  <section class="cold-open" data-scene="SC.02|Cold open" data-sky aria-labelledby="cold-title">
    <div class="sky-layer" aria-hidden="true">
      <Cloud name="bank-right" class="cc-far" sizes="(min-width: 900px) 56vw, 120vw" />
    </div>
    <div class="sky-layer sky-front" aria-hidden="true">
      <Cloud name="bank-left" class="cc-left" />
      <Cloud name="bank-right" class="cc-right" />
    </div>
    <div class="cold-inner wrap">
      <p class="slate reveal"><span class="slate-sc">SC.02</span> Cold open</p>
      <h2 id="cold-title" class="cold-line focus-pull">Oh. I didn’t see you there.</h2>
      <p class="cold-sub reveal">
        And honestly, I probably won’t until we <a href="#contact">set up a meeting</a>.
      </p>
      <p class="cold-aside reveal">Still here? Fine. <span class="af">Roll the tape.</span></p>
      <p class="cold-cloud reveal">Nefeli <span lang="el">(νεφέλη)</span> is Greek for cloud. Head in them, feet on set.</p>
    </div>
    <div class="sky-layer sky-near" aria-hidden="true">
      <Cloud name="puff" class="cc-near" sizes="(min-width: 900px) 45vw, 90vw" />
    </div>
  </section>

  <!-- SC.03 · Filmography -->
  <section id="work" class="section wrap" data-scene="SC.03|Filmography" aria-labelledby="work-title">
    <header class="section-head">
      <p class="slate reveal"><span class="slate-sc">SC.03</span> Filmography</p>
      <h2 id="work-title" class="section-title focus-pull">
        Six films, most of the jobs on set. <span class="dim">Yes, including <span class="af">catering.</span></span>
      </h2>
      <p class="section-note reveal">
        Production manager, production assistant, script supervisor and director. Pick a still for the full credits.
      </p>
    </header>
    <ul class="film-grid" role="list">
      {films.map((film, i) => <FilmCard film={film} index={i} span={SPANS[i % SPANS.length]} />)}
    </ul>
  </section>

  <!-- SC.04 · Chapters -->
  <section id="chapters" class="chapters" data-scene="SC.04|Chapters" aria-labelledby="chapters-title">
    <div class="sheet">
      <span class="ribbon" aria-hidden="true"></span>
      <header class="book-head">
        <p class="slate"><span class="slate-sc">SC.04</span> The words</p>
        <h2 id="chapters-title" class="book-title focus-pull">Chapters</h2>
        <p class="book-intro">
          Before the films, there were words. Five years of campaigns, briefs and ideas, told the only way a copywriter
          knows how: <span class="af">as a story.</span>
        </p>
      </header>
      <nav class="toc" aria-label="Chapters">
        <p class="toc-heading">Contents</p>
        <ol class="toc-list" role="list">
          {
            chapters.map((c) => (
              <li class="toc-item reveal">
                <a class="toc-link" href={url(`chapters/${c.id}/`)} data-cursor="Read">
                  <span class="toc-num">{chapterNumeral(c)}<span class="visually-hidden">:</span></span>{' '}
                  <span class="toc-title">
                    {c.data.title}
                    {c.data.draft && <span class="draft-tag">Draft</span>}
                  </span>{' '}
                  <span class="toc-leader" aria-hidden="true" />
                  <span class="toc-meta">
                    {c.data.client} · {c.data.year}<span class="visually-hidden">.</span>
                  </span>{' '}
                  <span class="toc-logline">{c.data.logline}</span>
                </a>
              </li>
            ))
          }
          <li class="toc-item toc-epilogue reveal">
            <a class="toc-link" href="#contact" data-cursor="Write it">
              <span class="toc-num">Epilogue<span class="visually-hidden">:</span></span>{' '}
              <span class="toc-title">To be continued <em>(co-write it?)</em></span>{' '}
              <span class="toc-leader" aria-hidden="true"></span>
              <span class="toc-meta">You · Soon<span class="visually-hidden">.</span></span>{' '}
              <span class="toc-logline">The next chapter needs a production, a crew or a client. Could be yours.</span>
            </a>
          </li>
        </ol>
      </nav>
    </div>
  </section>

  <!-- SC.05 · About -->
  <section id="about" class="section wrap about" data-scene="SC.05|About" aria-labelledby="about-title">
    <p class="slate reveal"><span class="slate-sc">SC.05</span> About</p>
    <h2 id="about-title" class="visually-hidden">About Nefeli</h2>
    <p class="manifesto" data-words>
      I’m Nefeli. I studied marketing, spent five years in advertising and brand marketing, and wrote copy at McCann and
      DDB for brands you’ve probably scrolled past. Somewhere between the briefs, I fell for film. Now I build shooting
      schedules, write call sheets, sort the transport and feed the crew. Thirteen years of ballet taught me discipline.
      Advertising taught me deadlines. Film is where I get to use both.
    </p>
    <dl class="facts">
      {
        facts.map(([k, v]) => (
          <div class="fact reveal">
            <dt>{k}</dt>
            <dd>{v}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <!-- SC.06 · The pitch -->
  <section id="why" class="section wrap pitch" data-scene="SC.06|The pitch" aria-labelledby="why-title">
    <header class="section-head">
      <p class="slate reveal"><span class="slate-sc">SC.06</span> The pitch</p>
      <h2 id="why-title" class="section-title focus-pull">Why me? <span class="dim">Glad you <span class="af">asked.</span></span></h2>
    </header>
    <div class="reasons">
      {
        reasons.map((r, i) => (
          <details class="reason reveal" name="reasons" open={i === 0}>
            <summary>
              <span class="reason-n">{String(i + 1).padStart(2, '0')}</span>{' '}
              <span class="reason-text">
                <span class="reason-h">{r.h}</span>{' '}
                <span class="reason-sub">{r.sub}</span>
              </span>
              <span class="reason-plus" aria-hidden="true" />
            </summary>
            <div class="reason-body">
              <ul>
                {r.items.map((item) => <li>{item}</li>)}
              </ul>
              {r.more && (
                <a class="text-link" href={r.more.href}>
                  {r.more.text} <Arrow />
                </a>
              )}
            </div>
          </details>
        ))
      }
    </div>
    <p class="pitch-end reveal">Now I want to be on set <mark>every day</mark>, not just on weekends.</p>
  </section>

  <!-- SC.07 · The long version -->
  <section id="cv" class="section wrap cv" data-scene="SC.07|The long version" aria-labelledby="cv-title">
    <div class="cv-copy">
      <p class="slate reveal"><span class="slate-sc">SC.07</span> The long version</p>
      <h2 id="cv-title" class="section-title focus-pull">
        Want the long version? <span class="dim">It’s one page. <span class="af">I’m efficient.</span></span>
      </h2>
      <ol class="credits-roll" data-credits aria-hidden="true">
        <li>Directed by Nefeli Koumantaki</li>
        <li>Produced by Nefeli Koumantaki</li>
        <li>Written by Nefeli Koumantaki</li>
        <li>Starring you, for reading this far</li>
      </ol>
    </div>
    <Clapper />
  </section>

  <!-- SC.08 · Call sheet -->
  <section id="contact" class="section wrap contact" data-scene="SC.08|Call sheet" aria-labelledby="contact-title">
    <p class="slate reveal"><span class="slate-sc">SC.08</span> Call sheet</p>
    <h2 id="contact-title" class="section-title focus-pull">
      Let’s make something. <span class="dim">I’ll bring the <span class="af">call sheet.</span></span>
    </h2>
    <a class="contact-mail" href={`mailto:${SITE.email}`} data-cursor="Say hi">{SITE.email}</a>
    <div class="contact-grid">
      <div class="contact-direct">
        <ul class="contact-links" role="list">
          <li><a href={SITE.linkedin} rel="me noopener" target="_blank">LinkedIn <Arrow dir="out" /></a></li>
          <li><a href={`tel:${SITE.phoneHref}`}>{SITE.phone}</a></li>
          <li><a href={url(SITE.cv)} download={SITE.cvDownloadName}>CV, PDF <Arrow dir="down" /></a></li>
        </ul>
        <p class="contact-note">
          Based in Athens. I reply to emails, which in this industry is basically a superpower.
        </p>
      </div>
      <CallSheet />
    </div>
  </section>

</Base>
